{
  "name": "dsh-ha-ingress-auth",
  "version": "0.1.0",
  "description": "Home Assistant ingress as the user and role layer for DeepSeek Harness: one dsh process per HA user, admin-only settings, per-user preferences.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "bin": { "dsh-ha-gateway": "src/gateway/cli.js" },
  "exports": {
    "./host": "./src/plugin/host.js",
    "./gateway/*": "./src/gateway/*.js"
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "app:context": "node scripts/app-context.js",
    "e2e": "node e2e/run.js"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.7-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.7-alpha.2",
    "@playwright/test": "1.63.0",
    "ws": "8.21.3"
  }
}
